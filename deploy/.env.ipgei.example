# ════════════════════════════════════════════════════════════════════════════
# IPGEI — variables du deploiement.
#
# A COPIER en `.env` DANS CE DOSSIER sur le serveur, puis a remplir :
#     cp .env.ipgei.example .env && chmod 600 .env
#
# Ce fichier-ci est un MODELE : il ne contient aucun secret et peut vivre dans
# git. Le `.env` reel, lui, n'y entre JAMAIS (.gitignore le couvre deja).
# ════════════════════════════════════════════════════════════════════════════

# ── Ou l'application repond ────────────────────────────────────────────────
# Sert a trois choses a la fois : ALLOWED_HOSTS, l'origine CORS, et l'URL
# gravee dans le QR des documents officiels.
PUBLIC_IP=208.85.19.82
PUBLIC_PORT=9090

# ── Cle de signature Django ────────────────────────────────────────────────
# Signe les jetons et les cookies. La changer invalide toutes les sessions.
# En generer une, sur le serveur :
#     python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# ── Base de donnees ────────────────────────────────────────────────────────
# Le mot de passe n'est lu qu'a la CREATION du volume : le modifier ensuite
# ne change rien dans PostgreSQL, il faudra le faire en SQL.
DB_NAME=ipgei
DB_USER=ipgei
DB_PASSWORD=

# ── Notes ──────────────────────────────────────────────────────────────────
# • Pas de REDIS_URL : Django utilise son cache memoire. C'est voulu — la RAM
#   est comptee sur ce serveur, qui heberge deja deux autres piles.
# • Pas de DJANGO_SSL_REDIRECT ni de cookies Secure : le service est en HTTP.
#   Le jour ou un certificat existera, poser DJANGO_COOKIE_SECURE=True dans le
#   compose et remettre une redirection cote Nginx.
