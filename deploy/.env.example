# ═══════════════════════════════════════════════════════════════
# Variables d'environnement SIGA
# Copie ce fichier en .env et remplis les valeurs reelles.
# Le fichier .env n'est PAS versionne (cf .gitignore).
# ═══════════════════════════════════════════════════════════════

# Domaine ou IP servi par Nginx
# Exemples : siga.iss.mr  /  siga.local  /  192.168.1.50
DOMAIN=siga.local

# Cle Django (genere avec : python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=REMPLACE-PAR-UNE-CLE-ALEATOIRE-DE-50-CARACTERES

# Mot de passe BD (utilisateur 'siga')
DB_PASSWORD=ChangeMoiUnMdpFort2026

# Mot de passe root MySQL (utilise pour les sauvegardes / admin)
DB_ROOT_PASSWORD=ChangeMoiUnAutreMdpFort2026
